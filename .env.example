# Backend/runtime defaults
SERVICE_ROLE=fetcher
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
SQLITE_JOURNAL_MODE=DELETE
FRAME_INTERVAL_SECONDS=0.04
SEGMENT_SCAN_SECONDS=0.04
MJPEG_JPEG_QUALITY=80
ANALYTICS_USE_YOLO=true
YOLO_MODEL_PATH=./data/models/yolo26x.pt
YOLO_CONFIDENCE=0.3
BOXMOT_REID_WEIGHTS=./data/models/osnet_x0_25_msmt17.pt
PERSONVIT_REID_WEIGHTS=./data/models/personvit/checkpoint0260.pth
PERSONVIT_USE_REID=true
PERSONVIT_SIMILARITY_THRESHOLD=0.6

# Docker Compose uses the built-in default `http://backend:8000`.
# For local frontend development, pass this inline instead:
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000 npm run dev
